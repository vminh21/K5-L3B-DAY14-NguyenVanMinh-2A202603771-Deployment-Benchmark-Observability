# Copy: cp .env.example .env  (.env đã nằm trong .gitignore — không commit)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Secret: đặt giá trị thật trên platform (Railway/Render variables), không ghi vào code
AGENT_API_KEY=change-me
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
